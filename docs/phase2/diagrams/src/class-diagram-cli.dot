digraph "Cli" {
  graph [rankdir=LR, fontname="DejaVu Sans", fontsize=11, nodesep=0.35, ranksep=0.55, splines=true, pad=0.3 ];
  node  [shape=plain, fontname="DejaVu Sans", fontsize=10];
  edge  [fontname="DejaVu Sans", fontsize=9, labeldistance=1.6, labelangle=30, color="#333333"];
  "ConsoleApp" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0"><TR><TD BGCOLOR="#FFFFFF" CELLPADDING="4"><B>ConsoleApp</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- io: ConsoleIO {readOnly}<BR ALIGN="LEFT"/>- session: UserSession {readOnly}<BR ALIGN="LEFT"/>- authMenu: AuthMenu {readOnly}<BR ALIGN="LEFT"/>- profileMenu: ProfileMenu {readOnly}<BR ALIGN="LEFT"/>- productMenu: ProductMenu {readOnly}<BR ALIGN="LEFT"/>- cartMenu: CartMenu {readOnly}<BR ALIGN="LEFT"/>- orderMenu: OrderMenu {readOnly}<BR ALIGN="LEFT"/>- adminMenu: AdminMenu {readOnly}<BR ALIGN="LEFT"/>- running: boolean<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ start()<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  "AuthMenu" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0"><TR><TD BGCOLOR="#FFFFFF" CELLPADDING="4"><B>AuthMenu</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- io: ConsoleIO {readOnly}<BR ALIGN="LEFT"/>- authService: AuthService {readOnly}<BR ALIGN="LEFT"/>- recoveryService: PasswordRecoveryService {readOnly}<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ login()<BR ALIGN="LEFT"/>+ register()<BR ALIGN="LEFT"/>+ forgotPassword()<BR ALIGN="LEFT"/>+ logout()<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  "ProfileMenu" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0"><TR><TD BGCOLOR="#FFFFFF" CELLPADDING="4"><B>ProfileMenu</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- io: ConsoleIO {readOnly}<BR ALIGN="LEFT"/>- printer: ConsolePrinter {readOnly}<BR ALIGN="LEFT"/>- profileService: ProfileService {readOnly}<BR ALIGN="LEFT"/>- session: UserSession {readOnly}<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ viewProfile()<BR ALIGN="LEFT"/>+ manage()<BR ALIGN="LEFT"/>+ addAddress()<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  "ProductMenu" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0"><TR><TD BGCOLOR="#FFFFFF" CELLPADDING="4"><B>ProductMenu</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- io: ConsoleIO {readOnly}<BR ALIGN="LEFT"/>- printer: ConsolePrinter {readOnly}<BR ALIGN="LEFT"/>- productService: ProductService {readOnly}<BR ALIGN="LEFT"/>- reviewService: ReviewService {readOnly}<BR ALIGN="LEFT"/>- session: UserSession {readOnly}<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ browse()<BR ALIGN="LEFT"/>+ search()<BR ALIGN="LEFT"/>+ filterAndSort()<BR ALIGN="LEFT"/>+ showDetails()<BR ALIGN="LEFT"/>+ rate()<BR ALIGN="LEFT"/>+ comment()<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  "CartMenu" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0"><TR><TD BGCOLOR="#FFFFFF" CELLPADDING="4"><B>CartMenu</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- io: ConsoleIO {readOnly}<BR ALIGN="LEFT"/>- printer: ConsolePrinter {readOnly}<BR ALIGN="LEFT"/>- cartService: CartService {readOnly}<BR ALIGN="LEFT"/>- session: UserSession {readOnly}<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ view()<BR ALIGN="LEFT"/>+ add()<BR ALIGN="LEFT"/>+ changeQuantity()<BR ALIGN="LEFT"/>+ remove()<BR ALIGN="LEFT"/>+ clear()<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  "OrderMenu" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0"><TR><TD BGCOLOR="#FFFFFF" CELLPADDING="4"><B>OrderMenu</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- io: ConsoleIO {readOnly}<BR ALIGN="LEFT"/>- printer: ConsolePrinter {readOnly}<BR ALIGN="LEFT"/>- session: UserSession {readOnly}<BR ALIGN="LEFT"/>- cartService: CartService {readOnly}<BR ALIGN="LEFT"/>- orderService: OrderService {readOnly}<BR ALIGN="LEFT"/>- paymentService: PaymentService {readOnly}<BR ALIGN="LEFT"/>- gatewaySimulation: GatewaySimulationControl {readOnly}<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ checkout()<BR ALIGN="LEFT"/>+ payPending()<BR ALIGN="LEFT"/>+ viewOrders()<BR ALIGN="LEFT"/>+ viewOrderDetails()<BR ALIGN="LEFT"/>+ cancelPending()<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  "AdminMenu" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0"><TR><TD BGCOLOR="#FFFFFF" CELLPADDING="4"><B>AdminMenu</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- io: ConsoleIO {readOnly}<BR ALIGN="LEFT"/>- printer: ConsolePrinter {readOnly}<BR ALIGN="LEFT"/>- session: UserSession {readOnly}<BR ALIGN="LEFT"/>- productService: ProductService {readOnly}<BR ALIGN="LEFT"/>- inventoryService: InventoryService {readOnly}<BR ALIGN="LEFT"/>- orderService: OrderService {readOnly}<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ addCategory()<BR ALIGN="LEFT"/>+ toggleCategory()<BR ALIGN="LEFT"/>+ addProduct()<BR ALIGN="LEFT"/>+ editProduct()<BR ALIGN="LEFT"/>+ toggleProduct()<BR ALIGN="LEFT"/>+ viewAllProducts()<BR ALIGN="LEFT"/>+ viewInventory()<BR ALIGN="LEFT"/>+ changeStock()<BR ALIGN="LEFT"/>+ viewOrders()<BR ALIGN="LEFT"/>+ viewOrderDetails()<BR ALIGN="LEFT"/>+ updateOrderStatus()<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  "ConsoleIO" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0"><TR><TD BGCOLOR="#FFFFFF" CELLPADDING="4"><B>ConsoleIO</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ println(text: String)<BR ALIGN="LEFT"/>+ printf(format: String, args: Object...)<BR ALIGN="LEFT"/>+ readLine(prompt: String): String<BR ALIGN="LEFT"/>+ readInt(prompt: String): int<BR ALIGN="LEFT"/>+ readOptionalInt(prompt: String): Integer<BR ALIGN="LEFT"/>+ readMoney(prompt: String, fieldName: String): BigDecimal<BR ALIGN="LEFT"/>+ readOptionalMoney(prompt: String, fieldName: String): BigDecimal<BR ALIGN="LEFT"/>+ readOptionalDouble(prompt: String): Double<BR ALIGN="LEFT"/>+ confirm(prompt: String): boolean<BR ALIGN="LEFT"/>+ chooseIndex(prompt: String, size: int): int<BR ALIGN="LEFT"/>+ runSafely(action: Runnable)<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  "ConsolePrinter" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0"><TR><TD BGCOLOR="#FFFFFF" CELLPADDING="4"><B>ConsolePrinter</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ printProducts(products: List&lt;Product&gt;)<BR ALIGN="LEFT"/>+ printInventory(products: List&lt;Product&gt;)<BR ALIGN="LEFT"/>+ printProductDetails(p: Product, comments: List&lt;Review&gt;)<BR ALIGN="LEFT"/>+ printCart(cart: Cart)<BR ALIGN="LEFT"/>+ printOrderLine(o: Order)<BR ALIGN="LEFT"/>+ printOrderDetails(o: Order, adminView: boolean)<BR ALIGN="LEFT"/>+ printAddresses(addresses: List&lt;Address&gt;)<BR ALIGN="LEFT"/>+ printProfile(user: User)<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  "UserSession" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0"><TR><TD BGCOLOR="#EEEEEE" CELLPADDING="4"><B>UserSession</B></TD></TR></TABLE>>];
  "AuthService" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0"><TR><TD BGCOLOR="#EEEEEE" CELLPADDING="4"><B>AuthService</B></TD></TR></TABLE>>];
  "PasswordRecoveryService" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0"><TR><TD BGCOLOR="#EEEEEE" CELLPADDING="4"><B>PasswordRecoveryService</B></TD></TR></TABLE>>];
  "ProfileService" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0"><TR><TD BGCOLOR="#EEEEEE" CELLPADDING="4"><B>ProfileService</B></TD></TR></TABLE>>];
  "ProductService" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0"><TR><TD BGCOLOR="#EEEEEE" CELLPADDING="4"><B>ProductService</B></TD></TR></TABLE>>];
  "ReviewService" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0"><TR><TD BGCOLOR="#EEEEEE" CELLPADDING="4"><B>ReviewService</B></TD></TR></TABLE>>];
  "CartService" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0"><TR><TD BGCOLOR="#EEEEEE" CELLPADDING="4"><B>CartService</B></TD></TR></TABLE>>];
  "OrderService" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0"><TR><TD BGCOLOR="#EEEEEE" CELLPADDING="4"><B>OrderService</B></TD></TR></TABLE>>];
  "PaymentService" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0"><TR><TD BGCOLOR="#EEEEEE" CELLPADDING="4"><B>PaymentService</B></TD></TR></TABLE>>];
  "InventoryService" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0"><TR><TD BGCOLOR="#EEEEEE" CELLPADDING="4"><B>InventoryService</B></TD></TR></TABLE>>];
  "GatewaySimulationControl" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0"><TR><TD BGCOLOR="#EEEEEE" CELLPADDING="4"><FONT POINT-SIZE="9">«interface»</FONT><BR/><B>GatewaySimulationControl</B></TD></TR></TABLE>>];
  "ConsoleApp" -> "ConsoleIO" [arrowhead=vee, style=solid, label=" io ", headlabel="1"];
  "ConsoleApp" -> "UserSession" [arrowhead=vee, style=solid, label=" session ", headlabel="1"];
  "ConsoleApp" -> "AuthMenu" [arrowhead=vee, style=solid, label=" authMenu ", headlabel="1"];
  "ConsoleApp" -> "ProfileMenu" [arrowhead=vee, style=solid, label=" profileMenu ", headlabel="1"];
  "ConsoleApp" -> "ProductMenu" [arrowhead=vee, style=solid, label=" productMenu ", headlabel="1"];
  "ConsoleApp" -> "CartMenu" [arrowhead=vee, style=solid, label=" cartMenu ", headlabel="1"];
  "ConsoleApp" -> "OrderMenu" [arrowhead=vee, style=solid, label=" orderMenu ", headlabel="1"];
  "ConsoleApp" -> "AdminMenu" [arrowhead=vee, style=solid, label=" adminMenu ", headlabel="1"];
  "AuthMenu" -> "ConsoleIO" [arrowhead=vee, style=solid, label=" io ", headlabel="1"];
  "AuthMenu" -> "AuthService" [arrowhead=vee, style=solid, label=" authService ", headlabel="1"];
  "AuthMenu" -> "PasswordRecoveryService" [arrowhead=vee, style=solid, label=" recoveryService ", headlabel="1"];
  "ProfileMenu" -> "ConsoleIO" [arrowhead=vee, style=solid, label=" io ", headlabel="1"];
  "ProfileMenu" -> "ConsolePrinter" [arrowhead=vee, style=solid, label=" printer ", headlabel="1"];
  "ProfileMenu" -> "ProfileService" [arrowhead=vee, style=solid, label=" profileService ", headlabel="1"];
  "ProfileMenu" -> "UserSession" [arrowhead=vee, style=solid, label=" session ", headlabel="1"];
  "ProductMenu" -> "ConsoleIO" [arrowhead=vee, style=solid, label=" io ", headlabel="1"];
  "ProductMenu" -> "ConsolePrinter" [arrowhead=vee, style=solid, label=" printer ", headlabel="1"];
  "ProductMenu" -> "ProductService" [arrowhead=vee, style=solid, label=" productService ", headlabel="1"];
  "ProductMenu" -> "ReviewService" [arrowhead=vee, style=solid, label=" reviewService ", headlabel="1"];
  "ProductMenu" -> "UserSession" [arrowhead=vee, style=solid, label=" session ", headlabel="1"];
  "CartMenu" -> "ConsoleIO" [arrowhead=vee, style=solid, label=" io ", headlabel="1"];
  "CartMenu" -> "ConsolePrinter" [arrowhead=vee, style=solid, label=" printer ", headlabel="1"];
  "CartMenu" -> "CartService" [arrowhead=vee, style=solid, label=" cartService ", headlabel="1"];
  "CartMenu" -> "UserSession" [arrowhead=vee, style=solid, label=" session ", headlabel="1"];
  "OrderMenu" -> "ConsoleIO" [arrowhead=vee, style=solid, label=" io ", headlabel="1"];
  "OrderMenu" -> "ConsolePrinter" [arrowhead=vee, style=solid, label=" printer ", headlabel="1"];
  "OrderMenu" -> "UserSession" [arrowhead=vee, style=solid, label=" session ", headlabel="1"];
  "OrderMenu" -> "CartService" [arrowhead=vee, style=solid, label=" cartService ", headlabel="1"];
  "OrderMenu" -> "OrderService" [arrowhead=vee, style=solid, label=" orderService ", headlabel="1"];
  "OrderMenu" -> "PaymentService" [arrowhead=vee, style=solid, label=" paymentService ", headlabel="1"];
  "OrderMenu" -> "GatewaySimulationControl" [arrowhead=vee, style=solid, label=" gatewaySimulation ", headlabel="1"];
  "AdminMenu" -> "ConsoleIO" [arrowhead=vee, style=solid, label=" io ", headlabel="1"];
  "AdminMenu" -> "ConsolePrinter" [arrowhead=vee, style=solid, label=" printer ", headlabel="1"];
  "AdminMenu" -> "UserSession" [arrowhead=vee, style=solid, label=" session ", headlabel="1"];
  "AdminMenu" -> "ProductService" [arrowhead=vee, style=solid, label=" productService ", headlabel="1"];
  "AdminMenu" -> "InventoryService" [arrowhead=vee, style=solid, label=" inventoryService ", headlabel="1"];
  "AdminMenu" -> "OrderService" [arrowhead=vee, style=solid, label=" orderService ", headlabel="1"];
  "ConsolePrinter" -> "ConsoleIO" [arrowhead=vee, style=solid, label=" io ", headlabel="1"];
  note [shape=note, fontsize=9, style=filled, fillcolor="#FFFDE7", label="Package shop.cli (presentation layer)\lMain (composition root) creates all objects and injects them\lthrough constructors; menus never create services themselves.\l"];
}
