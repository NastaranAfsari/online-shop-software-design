digraph "ClassDiagramModel" {
  graph [rankdir=TB, fontname="DejaVu Sans", fontsize=11, nodesep=0.35, ranksep=0.55, splines=true, pad=0.3 ];
  node  [shape=plain, fontname="DejaVu Sans", fontsize=10];
  edge  [fontname="DejaVu Sans", fontsize=9, labeldistance=1.6, labelangle=30, color="#333333"];
  "User" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0"><TR><TD BGCOLOR="#FFFFFF" CELLPADDING="4"><B>User</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- id: String {readOnly}<BR ALIGN="LEFT"/>- fullName: String<BR ALIGN="LEFT"/>- email: String<BR ALIGN="LEFT"/>- phone: String<BR ALIGN="LEFT"/>- passwordHash: String<BR ALIGN="LEFT"/>- role: Role {readOnly}<BR ALIGN="LEFT"/>- addresses: List&lt;Address&gt; {readOnly}<BR ALIGN="LEFT"/>- cart: Cart {readOnly}<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ updateProfile(newFullName: String, newEmail: String, newPhone: String)<BR ALIGN="LEFT"/>+ changePasswordHash(newHash: String)<BR ALIGN="LEFT"/>+ isAdmin(): boolean<BR ALIGN="LEFT"/>+ isCustomer(): boolean<BR ALIGN="LEFT"/>+ addAddress(address: Address)<BR ALIGN="LEFT"/>+ updateAddress(oldTitle: String, newData: Address)<BR ALIGN="LEFT"/>+ removeAddress(title: String)<BR ALIGN="LEFT"/>+ setDefaultAddress(title: String)<BR ALIGN="LEFT"/>+ findAddress(title: String): Optional&lt;Address&gt;<BR ALIGN="LEFT"/>+ getDefaultAddress(): Optional&lt;Address&gt;<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  "Cart" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0"><TR><TD BGCOLOR="#FFFFFF" CELLPADDING="4"><B>Cart</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- userId: String {readOnly}<BR ALIGN="LEFT"/>- items: List&lt;CartItem&gt; {readOnly}<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ isEmpty(): boolean<BR ALIGN="LEFT"/>+ findItem(productId: String): Optional&lt;CartItem&gt;<BR ALIGN="LEFT"/>+ addItem(product: Product, quantity: int)<BR ALIGN="LEFT"/>+ updateQuantity(productId: String, newQuantity: int)<BR ALIGN="LEFT"/>+ decreaseItem(productId: String, amount: int)<BR ALIGN="LEFT"/>+ removeItem(productId: String)<BR ALIGN="LEFT"/>+ clear()<BR ALIGN="LEFT"/>+ getTotalQuantity(): int<BR ALIGN="LEFT"/>+ getTotalPrice(): BigDecimal<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  "CartItem" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0"><TR><TD BGCOLOR="#FFFFFF" CELLPADDING="4"><B>CartItem</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- product: Product {readOnly}<BR ALIGN="LEFT"/>- quantity: int<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">~ setQuantity(quantity: int)<BR ALIGN="LEFT"/>+ getSubtotal(): BigDecimal<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  "Address" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0"><TR><TD BGCOLOR="#FFFFFF" CELLPADDING="4"><B>Address</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- title: String {readOnly}<BR ALIGN="LEFT"/>- recipientName: String {readOnly}<BR ALIGN="LEFT"/>- phoneNumber: String {readOnly}<BR ALIGN="LEFT"/>- country: String {readOnly}<BR ALIGN="LEFT"/>- city: String {readOnly}<BR ALIGN="LEFT"/>- street: String {readOnly}<BR ALIGN="LEFT"/>- postalCode: String {readOnly}<BR ALIGN="LEFT"/>- defaultAddress: boolean {readOnly}<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ isDefault(): boolean<BR ALIGN="LEFT"/>+ withDefault(isDefault: boolean): Address<BR ALIGN="LEFT"/>+ equals(o: Object): boolean<BR ALIGN="LEFT"/>+ hashCode(): int<BR ALIGN="LEFT"/>+ toString(): String<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  "Product" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0"><TR><TD BGCOLOR="#FFFFFF" CELLPADDING="4"><B>Product</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- id: String {readOnly}<BR ALIGN="LEFT"/>- title: String<BR ALIGN="LEFT"/>- description: String<BR ALIGN="LEFT"/>- price: BigDecimal<BR ALIGN="LEFT"/>- stock: int<BR ALIGN="LEFT"/>- brand: String<BR ALIGN="LEFT"/>- category: Category<BR ALIGN="LEFT"/>- createdAt: LocalDateTime {readOnly}<BR ALIGN="LEFT"/>- reviews: List&lt;Review&gt; {readOnly}<BR ALIGN="LEFT"/>- imageUrls: List&lt;String&gt; {readOnly}<BR ALIGN="LEFT"/>- stockHistory: List&lt;StockMovement&gt; {readOnly}<BR ALIGN="LEFT"/>- active: boolean<BR ALIGN="LEFT"/>- soldCount: int<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ updateDetails(title: String, description: String, price: BigDecimal, brand: String, category: Category)<BR ALIGN="LEFT"/>+ addImage(url: String)<BR ALIGN="LEFT"/>+ increaseStock(count: int, reason: String, performedBy: String)<BR ALIGN="LEFT"/>+ decreaseStock(count: int, reason: String, performedBy: String)<BR ALIGN="LEFT"/>+ adjustStockTo(newStock: int, reason: String, performedBy: String)<BR ALIGN="LEFT"/>+ recordSale(count: int)<BR ALIGN="LEFT"/>+ revertSale(count: int)<BR ALIGN="LEFT"/>+ putReview(review: Review)<BR ALIGN="LEFT"/>+ findReviewByUser(userId: String): Optional&lt;Review&gt;<BR ALIGN="LEFT"/>+ getComments(): List&lt;Review&gt;<BR ALIGN="LEFT"/>+ getRatingCount(): int<BR ALIGN="LEFT"/>+ getAverageRating(): double<BR ALIGN="LEFT"/>+ isAvailable(): boolean<BR ALIGN="LEFT"/>+ setActive(active: boolean)<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  "Category" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0"><TR><TD BGCOLOR="#FFFFFF" CELLPADDING="4"><B>Category</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- id: String {readOnly}<BR ALIGN="LEFT"/>- name: String<BR ALIGN="LEFT"/>- description: String<BR ALIGN="LEFT"/>- active: boolean<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ rename(newName: String)<BR ALIGN="LEFT"/>+ setDescription(description: String)<BR ALIGN="LEFT"/>+ setActive(active: boolean)<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  "Review" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0"><TR><TD BGCOLOR="#FFFFFF" CELLPADDING="4"><B>Review</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- id: String {readOnly}<BR ALIGN="LEFT"/>- userId: String {readOnly}<BR ALIGN="LEFT"/>- reviewerName: String {readOnly}<BR ALIGN="LEFT"/>- score: Integer {readOnly}<BR ALIGN="LEFT"/>- comment: String {readOnly}<BR ALIGN="LEFT"/>- createdAt: LocalDateTime {readOnly}<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><U>+ rating(userId: String, reviewerFullName: String, score: int): Review</U><BR ALIGN="LEFT"/><U>+ comment(userId: String, reviewerFullName: String, comment: String): Review</U><BR ALIGN="LEFT"/>+ withScore(newScore: int): Review<BR ALIGN="LEFT"/>+ withComment(newComment: String): Review<BR ALIGN="LEFT"/>+ hasScore(): boolean<BR ALIGN="LEFT"/>+ hasComment(): boolean<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  "StockMovement" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0"><TR><TD BGCOLOR="#FFFFFF" CELLPADDING="4"><B>StockMovement</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- productId: String {readOnly}<BR ALIGN="LEFT"/>- delta: int {readOnly}<BR ALIGN="LEFT"/>- resultingStock: int {readOnly}<BR ALIGN="LEFT"/>- reason: String {readOnly}<BR ALIGN="LEFT"/>- performedBy: String {readOnly}<BR ALIGN="LEFT"/>- timestamp: LocalDateTime {readOnly}<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"> </TD></TR></TABLE>>];
  "Order" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0"><TR><TD BGCOLOR="#FFFFFF" CELLPADDING="4"><B>Order</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- id: String {readOnly}<BR ALIGN="LEFT"/>- userId: String {readOnly}<BR ALIGN="LEFT"/>- items: List&lt;OrderItem&gt; {readOnly}<BR ALIGN="LEFT"/>- deliveryAddress: Address {readOnly}<BR ALIGN="LEFT"/>- payments: List&lt;Payment&gt; {readOnly}<BR ALIGN="LEFT"/>- creationDate: LocalDateTime {readOnly}<BR ALIGN="LEFT"/>- status: OrderStatus<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ addItem(product: Product, quantity: int)<BR ALIGN="LEFT"/>+ registerPayment(payment: Payment)<BR ALIGN="LEFT"/>+ changeStatus(newStatus: OrderStatus)<BR ALIGN="LEFT"/>+ cancel(): boolean<BR ALIGN="LEFT"/>+ isPayable(): boolean<BR ALIGN="LEFT"/>+ getTotalAmount(): BigDecimal<BR ALIGN="LEFT"/>+ getSuccessfulPayment(): Optional&lt;Payment&gt;<BR ALIGN="LEFT"/>+ getLatestPayment(): Optional&lt;Payment&gt;<BR ALIGN="LEFT"/>+ containsProduct(productId: String): boolean<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  "OrderItem" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0"><TR><TD BGCOLOR="#FFFFFF" CELLPADDING="4"><B>OrderItem</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- productId: String {readOnly}<BR ALIGN="LEFT"/>- productName: String {readOnly}<BR ALIGN="LEFT"/>- unitPrice: BigDecimal {readOnly}<BR ALIGN="LEFT"/>- quantity: int {readOnly}<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ getTotalPrice(): BigDecimal<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  "Payment" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0"><TR><TD BGCOLOR="#FFFFFF" CELLPADDING="4"><B>Payment</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- id: String {readOnly}<BR ALIGN="LEFT"/>- orderId: String {readOnly}<BR ALIGN="LEFT"/>- amount: BigDecimal {readOnly}<BR ALIGN="LEFT"/>- method: PaymentMethod {readOnly}<BR ALIGN="LEFT"/>- status: PaymentStatus<BR ALIGN="LEFT"/>- transactionRef: String<BR ALIGN="LEFT"/>- failureReason: String<BR ALIGN="LEFT"/>- paymentDate: LocalDateTime<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ markAsSuccess(transactionRef: String)<BR ALIGN="LEFT"/>+ markAsFailed(reason: String)<BR ALIGN="LEFT"/>+ markAsRefunded()<BR ALIGN="LEFT"/>+ isSuccessful(): boolean<BR ALIGN="LEFT"/>+ getMaskedTransactionRef(): String<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  "ProductFilter" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0"><TR><TD BGCOLOR="#FFFFFF" CELLPADDING="4"><B>ProductFilter</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- categoryId: String {readOnly}<BR ALIGN="LEFT"/>- minPrice: BigDecimal {readOnly}<BR ALIGN="LEFT"/>- maxPrice: BigDecimal {readOnly}<BR ALIGN="LEFT"/>- brand: String {readOnly}<BR ALIGN="LEFT"/>- minRating: Double {readOnly}<BR ALIGN="LEFT"/>- onlyAvailable: boolean {readOnly}<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><U>+ none(): ProductFilter</U><BR ALIGN="LEFT"/>+ matches(product: Product): boolean<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  "PasswordResetToken" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0"><TR><TD BGCOLOR="#FFFFFF" CELLPADDING="4"><B>PasswordResetToken</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- code: String {readOnly}<BR ALIGN="LEFT"/>- expiresAt: LocalDateTime {readOnly}<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ isExpired(): boolean<BR ALIGN="LEFT"/>+ matches(candidate: String): boolean<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  "Role" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0"><TR><TD BGCOLOR="#F2F2F2" CELLPADDING="4"><FONT POINT-SIZE="9">«enumeration»</FONT><BR/><B>Role</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">CUSTOMER<BR ALIGN="LEFT"/>ADMIN<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"> </TD></TR></TABLE>>];
  "OrderStatus" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0"><TR><TD BGCOLOR="#F2F2F2" CELLPADDING="4"><FONT POINT-SIZE="9">«enumeration»</FONT><BR/><B>OrderStatus</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">PENDING<BR ALIGN="LEFT"/>PAID<BR ALIGN="LEFT"/>SHIPPED<BR ALIGN="LEFT"/>DELIVERED<BR ALIGN="LEFT"/>CANCELED<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ getAllowedNextStatuses(): Set&lt;OrderStatus&gt;<BR ALIGN="LEFT"/>+ canTransitionTo(next: OrderStatus): boolean<BR ALIGN="LEFT"/>+ isPaidState(): boolean<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  "PaymentStatus" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0"><TR><TD BGCOLOR="#F2F2F2" CELLPADDING="4"><FONT POINT-SIZE="9">«enumeration»</FONT><BR/><B>PaymentStatus</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">PENDING<BR ALIGN="LEFT"/>SUCCESS<BR ALIGN="LEFT"/>FAILED<BR ALIGN="LEFT"/>REFUNDED<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"> </TD></TR></TABLE>>];
  "PaymentMethod" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0"><TR><TD BGCOLOR="#F2F2F2" CELLPADDING="4"><FONT POINT-SIZE="9">«enumeration»</FONT><BR/><B>PaymentMethod</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">CREDIT_CARD<BR ALIGN="LEFT"/>ONLINE_GATEWAY<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"> </TD></TR></TABLE>>];
  "ProductSortOption" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0"><TR><TD BGCOLOR="#F2F2F2" CELLPADDING="4"><FONT POINT-SIZE="9">«enumeration»</FONT><BR/><B>ProductSortOption</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">CHEAPEST<BR ALIGN="LEFT"/>MOST_EXPENSIVE<BR ALIGN="LEFT"/>NEWEST<BR ALIGN="LEFT"/>MOST_POPULAR<BR ALIGN="LEFT"/>HIGHEST_RATED<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- label: String {readOnly}<BR ALIGN="LEFT"/>- comparator: Comparator&lt;Product&gt; {readOnly}<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"> </TD></TR></TABLE>>];
  "Validators" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0"><TR><TD BGCOLOR="#F2F2F2" CELLPADDING="4"><FONT POINT-SIZE="9">«utility»</FONT><BR/><B>Validators</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><U>+ isBlank(value: String): boolean</U><BR ALIGN="LEFT"/><U>+ isValidEmail(email: String): boolean</U><BR ALIGN="LEFT"/><U>+ isValidPhone(phone: String): boolean</U><BR ALIGN="LEFT"/><U>+ isValidPassword(password: String): boolean</U><BR ALIGN="LEFT"/><U>+ isValidPostalCode(postalCode: String): boolean</U><BR ALIGN="LEFT"/><U>+ normalizeEmail(email: String): String</U><BR ALIGN="LEFT"/><U>+ normalizePhone(phone: String): String</U><BR ALIGN="LEFT"/><U>+ requireNonBlank(value: String, fieldName: String): String</U><BR ALIGN="LEFT"/><U>+ requirePositive(value: int, fieldName: String): int</U><BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  "Money" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0"><TR><TD BGCOLOR="#F2F2F2" CELLPADDING="4"><FONT POINT-SIZE="9">«utility»</FONT><BR/><B>Money</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><U>+ normalize(amount: BigDecimal, fieldName: String): BigDecimal</U><BR ALIGN="LEFT"/><U>+ parse(text: String, fieldName: String): BigDecimal</U><BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  "User" -> "Cart" [dir=both, arrowtail=diamond, arrowhead=vee, style=solid, label=" cart ", headlabel="1", taillabel="1"];
  "User" -> "Address" [dir=both, arrowtail=diamond, arrowhead=vee, style=solid, label=" addresses ", headlabel="0..*", taillabel="1"];
  "User" -> "Role" [arrowhead=vee, style=solid, label=" role ", headlabel="1"];
  "Cart" -> "CartItem" [dir=both, arrowtail=diamond, arrowhead=vee, style=solid, label=" items ", headlabel="0..*", taillabel="1"];
  "CartItem" -> "Product" [arrowhead=vee, style=solid, label=" product ", headlabel="1", taillabel="0..*"];
  "Product" -> "Category" [arrowhead=vee, style=solid, label=" category ", headlabel="1", taillabel="0..*"];
  "Product" -> "Review" [dir=both, arrowtail=diamond, arrowhead=vee, style=solid, label=" reviews ", headlabel="0..*", taillabel="1"];
  "Product" -> "StockMovement" [dir=both, arrowtail=diamond, arrowhead=vee, style=solid, label=" stockHistory ", headlabel="0..*", taillabel="1"];
  "Order" -> "OrderItem" [dir=both, arrowtail=diamond, arrowhead=vee, style=solid, label=" items ", headlabel="0..*", taillabel="1"];
  "Order" -> "Payment" [dir=both, arrowtail=diamond, arrowhead=vee, style=solid, label=" payments ", headlabel="0..*", taillabel="1"];
  "Order" -> "Address" [arrowhead=vee, style=solid, label=" deliveryAddress ", headlabel="1"];
  "Order" -> "OrderStatus" [arrowhead=vee, style=solid, label=" status ", headlabel="1"];
  "Payment" -> "PaymentStatus" [arrowhead=vee, style=solid, label=" status ", headlabel="1"];
  "Payment" -> "PaymentMethod" [arrowhead=vee, style=solid, label=" method ", headlabel="1"];
  "ProductFilter" -> "Product" [arrowhead=vee, style=dashed, label=" «use» matches "];
  "ProductSortOption" -> "Product" [arrowhead=vee, style=dashed, label=" «use» compares "];
  "Order" -> "Product" [arrowhead=vee, style=dashed, label=" «use» addItem "];
  note [shape=note, fontsize=9, style=filled, fillcolor="#FFFDE7", label="Package shop.model\l- Constructors and simple getters are omitted.\l- Validators and Money are used by most model classes\l  for validation and money handling (edges omitted).\l- OrderItem keeps productId and a price snapshot,\l  so an order does not change when a product changes.\l"];
  {rank=same; Validators; Money; note}
}
