digraph "ServicesAccounts" {
  graph [rankdir=TB, fontname="DejaVu Sans", fontsize=11, nodesep=0.35, ranksep=0.55, splines=true, pad=0.3 ];
  node  [shape=plain, fontname="DejaVu Sans", fontsize=10];
  edge  [fontname="DejaVu Sans", fontsize=9, labeldistance=1.6, labelangle=30, color="#333333"];
  "AuthService" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0"><TR><TD BGCOLOR="#FFFFFF" CELLPADDING="4"><B>AuthService</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- userRepository: UserRepository {readOnly}<BR ALIGN="LEFT"/>- passwordHasher: PasswordHasher {readOnly}<BR ALIGN="LEFT"/>- session: UserSession {readOnly}<BR ALIGN="LEFT"/>- uniqueContactPolicy: UniqueContactPolicy {readOnly}<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ register(fullName: String, email: String, phone: String, password: String): User<BR ALIGN="LEFT"/>+ registerFirstAdmin(fullName: String, email: String, phone: String, password: String): User<BR ALIGN="LEFT"/>+ createAdmin(actor: User, fullName: String, email: String, phone: String, password: String): User<BR ALIGN="LEFT"/>+ login(identifier: String, password: String): User<BR ALIGN="LEFT"/>+ logout()<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  "ProfileService" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0"><TR><TD BGCOLOR="#FFFFFF" CELLPADDING="4"><B>ProfileService</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- userRepository: UserRepository {readOnly}<BR ALIGN="LEFT"/>- session: UserSession {readOnly}<BR ALIGN="LEFT"/>- uniqueContactPolicy: UniqueContactPolicy {readOnly}<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ updateProfile(newFullName: String, newEmail: String, newPhone: String): User<BR ALIGN="LEFT"/>+ addAddress(address: Address)<BR ALIGN="LEFT"/>+ updateAddress(oldTitle: String, updatedAddress: Address)<BR ALIGN="LEFT"/>+ removeAddress(title: String)<BR ALIGN="LEFT"/>+ setDefaultAddress(title: String)<BR ALIGN="LEFT"/>+ getAddresses(): List&lt;Address&gt;<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  "PasswordRecoveryService" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0"><TR><TD BGCOLOR="#FFFFFF" CELLPADDING="4"><B>PasswordRecoveryService</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- userRepository: UserRepository {readOnly}<BR ALIGN="LEFT"/>- passwordHasher: PasswordHasher {readOnly}<BR ALIGN="LEFT"/>- resetTokens: Map&lt;String, PasswordResetToken&gt; {readOnly}<BR ALIGN="LEFT"/>- random: SecureRandom {readOnly}<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ requestPasswordReset(identifier: String): String<BR ALIGN="LEFT"/>+ resetPassword(identifier: String, code: String, newPassword: String)<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  "UserSession" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0"><TR><TD BGCOLOR="#FFFFFF" CELLPADDING="4"><B>UserSession</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- currentUser: User<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">~ start(user: User)<BR ALIGN="LEFT"/>~ end()<BR ALIGN="LEFT"/>+ isLoggedIn(): boolean<BR ALIGN="LEFT"/>+ isAdmin(): boolean<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  "UniqueContactPolicy" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0"><TR><TD BGCOLOR="#FFFFFF" CELLPADDING="4"><B>UniqueContactPolicy</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- userRepository: UserRepository {readOnly}<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">~ requireUnique(email: String, phone: String, self: User)<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  "Authorization" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0"><TR><TD BGCOLOR="#FFFFFF" CELLPADDING="4"><FONT POINT-SIZE="9">«utility»</FONT><BR/><B>Authorization</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><U>~ requireLoggedIn(user: User): User</U><BR ALIGN="LEFT"/><U>~ requireAdmin(user: User): User</U><BR ALIGN="LEFT"/><U>~ requireCustomer(user: User): User</U><BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  "PasswordHasher" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0"><TR><TD BGCOLOR="#FFFFFF" CELLPADDING="4"><FONT POINT-SIZE="9">«interface»</FONT><BR/><B>PasswordHasher</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ hash(rawPassword: String): String<BR ALIGN="LEFT"/>+ matches(rawPassword: String, storedHash: String): boolean<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  "Pbkdf2PasswordHasher" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0"><TR><TD BGCOLOR="#FFFFFF" CELLPADDING="4"><B>Pbkdf2PasswordHasher</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ hash(rawPassword: String): String<BR ALIGN="LEFT"/>+ matches(rawPassword: String, storedHash: String): boolean<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  "ProductService" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0"><TR><TD BGCOLOR="#FFFFFF" CELLPADDING="4"><B>ProductService</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- productRepository: ProductRepository {readOnly}<BR ALIGN="LEFT"/>- categoryRepository: CategoryRepository {readOnly}<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ createCategory(actor: User, name: String, description: String): Category<BR ALIGN="LEFT"/>+ setCategoryActive(actor: User, categoryId: String, active: boolean)<BR ALIGN="LEFT"/>+ getActiveCategories(): List&lt;Category&gt;<BR ALIGN="LEFT"/>+ getAllCategories(actor: User): List&lt;Category&gt;<BR ALIGN="LEFT"/>+ getCategoryById(categoryId: String): Category<BR ALIGN="LEFT"/>+ getActiveProducts(): List&lt;Product&gt;<BR ALIGN="LEFT"/>+ getProductById(id: String): Product<BR ALIGN="LEFT"/>+ searchProducts(keyword: String): List&lt;Product&gt;<BR ALIGN="LEFT"/>+ getProductsByCategory(categoryId: String): List&lt;Product&gt;<BR ALIGN="LEFT"/>+ filterAndSortProducts(filter: ProductFilter, sortOption: ProductSortOption): List&lt;Product&gt;<BR ALIGN="LEFT"/>+ createProduct(actor: User, title: String, description: String, price: BigDecimal, stock: int, brand: String, category: Category): Product<BR ALIGN="LEFT"/>+ updateProduct(actor: User, productId: String, title: String, description: String, price: BigDecimal, stock: int, brand: String, category: Category): Product<BR ALIGN="LEFT"/>+ setProductActive(actor: User, productId: String, active: boolean)<BR ALIGN="LEFT"/>+ getAllProductsForAdmin(actor: User): List&lt;Product&gt;<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  "ProductLookup" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0"><TR><TD BGCOLOR="#FFFFFF" CELLPADDING="4"><FONT POINT-SIZE="9">«interface»</FONT><BR/><B>ProductLookup</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ getProductById(id: String): Product<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  "UserRepository" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0"><TR><TD BGCOLOR="#EEEEEE" CELLPADDING="4"><FONT POINT-SIZE="9">«interface»</FONT><BR/><B>UserRepository</B></TD></TR></TABLE>>];
  "ProductRepository" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0"><TR><TD BGCOLOR="#EEEEEE" CELLPADDING="4"><FONT POINT-SIZE="9">«interface»</FONT><BR/><B>ProductRepository</B></TD></TR></TABLE>>];
  "CategoryRepository" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0"><TR><TD BGCOLOR="#EEEEEE" CELLPADDING="4"><FONT POINT-SIZE="9">«interface»</FONT><BR/><B>CategoryRepository</B></TD></TR></TABLE>>];
  "User" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0"><TR><TD BGCOLOR="#EEEEEE" CELLPADDING="4"><B>User</B></TD></TR></TABLE>>];
  "PasswordResetToken" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0"><TR><TD BGCOLOR="#EEEEEE" CELLPADDING="4"><B>PasswordResetToken</B></TD></TR></TABLE>>];
  "AuthService" -> "UserRepository" [arrowhead=vee, style=solid, label=" userRepository ", headlabel="1"];
  "AuthService" -> "PasswordHasher" [arrowhead=vee, style=solid, label=" passwordHasher ", headlabel="1"];
  "AuthService" -> "UserSession" [arrowhead=vee, style=solid, label=" session ", headlabel="1"];
  "AuthService" -> "UniqueContactPolicy" [arrowhead=vee, style=solid, label=" uniqueContactPolicy ", headlabel="1"];
  "ProfileService" -> "UserRepository" [arrowhead=vee, style=solid, label=" userRepository ", headlabel="1"];
  "ProfileService" -> "UserSession" [arrowhead=vee, style=solid, label=" session ", headlabel="1"];
  "ProfileService" -> "UniqueContactPolicy" [arrowhead=vee, style=solid, label=" uniqueContactPolicy ", headlabel="1"];
  "PasswordRecoveryService" -> "UserRepository" [arrowhead=vee, style=solid, label=" userRepository ", headlabel="1"];
  "PasswordRecoveryService" -> "PasswordHasher" [arrowhead=vee, style=solid, label=" passwordHasher ", headlabel="1"];
  "PasswordRecoveryService" -> "PasswordResetToken" [arrowhead=vee, style=solid, label=" resetTokens ", headlabel="0..*"];
  "UserSession" -> "User" [arrowhead=vee, style=solid, label=" currentUser ", headlabel="1"];
  "UniqueContactPolicy" -> "UserRepository" [arrowhead=vee, style=solid, label=" userRepository ", headlabel="1"];
  "PasswordHasher" -> "Pbkdf2PasswordHasher" [dir=back, arrowtail=onormal, style=dashed];
  "ProductService" -> "ProductRepository" [arrowhead=vee, style=solid, label=" productRepository ", headlabel="1"];
  "ProductService" -> "CategoryRepository" [arrowhead=vee, style=solid, label=" categoryRepository ", headlabel="1"];
  "ProductLookup" -> "ProductService" [dir=back, arrowtail=onormal, style=dashed];
  "AuthService" -> "Authorization" [arrowhead=vee, style=dashed, label=" «use» "];
  "ProfileService" -> "Authorization" [arrowhead=vee, style=dashed, label=" «use» "];
  "ProductService" -> "Authorization" [arrowhead=vee, style=dashed, label=" «use» "];
  note [shape=note, fontsize=9, style=filled, fillcolor="#FFFDE7", label="Package shop.service (accounts and catalog)\lGray boxes are shown in detail in other diagrams.\lConstructors and simple getters are omitted.\l"];
}
