digraph "ServicesOrders" {
  graph [rankdir=TB, fontname="DejaVu Sans", fontsize=11, nodesep=0.35, ranksep=0.55, splines=true, pad=0.3 ];
  node  [shape=plain, fontname="DejaVu Sans", fontsize=10];
  edge  [fontname="DejaVu Sans", fontsize=9, labeldistance=1.6, labelangle=30, color="#333333"];
  "CartService" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0"><TR><TD BGCOLOR="#FFFFFF" CELLPADDING="4"><B>CartService</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- productLookup: ProductLookup {readOnly}<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ addToCart(user: User, productId: String, quantity: int)<BR ALIGN="LEFT"/>+ updateQuantity(user: User, productId: String, newQuantity: int)<BR ALIGN="LEFT"/>+ decreaseQuantity(user: User, productId: String, amount: int)<BR ALIGN="LEFT"/>+ removeFromCart(user: User, productId: String)<BR ALIGN="LEFT"/>+ clearCart(user: User)<BR ALIGN="LEFT"/>+ getCart(user: User): Cart<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  "OrderService" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0"><TR><TD BGCOLOR="#FFFFFF" CELLPADDING="4"><B>OrderService</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- orderRepository: OrderRepository {readOnly}<BR ALIGN="LEFT"/>- cartService: CartService {readOnly}<BR ALIGN="LEFT"/>- stockHandler: OrderStockHandler {readOnly}<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ placeOrder(user: User, addressTitle: String): Order<BR ALIGN="LEFT"/>+ getUserOrders(user: User): List&lt;Order&gt;<BR ALIGN="LEFT"/>+ getOrderDetails(actor: User, orderId: String): Order<BR ALIGN="LEFT"/>+ getAllOrders(admin: User): List&lt;Order&gt;<BR ALIGN="LEFT"/>+ getOrdersByStatus(admin: User, status: OrderStatus): List&lt;Order&gt;<BR ALIGN="LEFT"/>+ updateOrderStatus(admin: User, orderId: String, newStatus: OrderStatus): Order<BR ALIGN="LEFT"/>+ cancelOrder(actor: User, orderId: String): Order<BR ALIGN="LEFT"/>+ hasUserPurchased(userId: String, productId: String): boolean<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  "PaymentService" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0"><TR><TD BGCOLOR="#FFFFFF" CELLPADDING="4"><B>PaymentService</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- orderRepository: OrderRepository {readOnly}<BR ALIGN="LEFT"/>- gateway: PaymentGateway {readOnly}<BR ALIGN="LEFT"/>- verificationRules: List&lt;PaymentVerificationRule&gt; {readOnly}<BR ALIGN="LEFT"/>- stockHandler: OrderStockHandler {readOnly}<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ pay(user: User, orderId: String, method: PaymentMethod): Payment<BR ALIGN="LEFT"/>+ getPayments(actor: User, orderId: String): List&lt;Payment&gt;<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  "ReviewService" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0"><TR><TD BGCOLOR="#FFFFFF" CELLPADDING="4"><B>ReviewService</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- productLookup: ProductLookup {readOnly}<BR ALIGN="LEFT"/>- purchaseHistory: PurchaseHistory {readOnly}<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ rateProduct(user: User, productId: String, score: int): Review<BR ALIGN="LEFT"/>+ commentOnProduct(user: User, productId: String, comment: String): Review<BR ALIGN="LEFT"/>+ getComments(productId: String): List&lt;Review&gt;<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  "InventoryService" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0"><TR><TD BGCOLOR="#FFFFFF" CELLPADDING="4"><B>InventoryService</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- productRepository: ProductRepository {readOnly}<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ viewInventory(actor: User): List&lt;Product&gt;<BR ALIGN="LEFT"/>+ increaseStock(actor: User, productId: String, amount: int, reason: String): Product<BR ALIGN="LEFT"/>+ decreaseStock(actor: User, productId: String, amount: int, reason: String): Product<BR ALIGN="LEFT"/>+ setStock(actor: User, productId: String, newStock: int, reason: String): Product<BR ALIGN="LEFT"/>+ getStockHistory(actor: User, productId: String): List&lt;StockMovement&gt;<BR ALIGN="LEFT"/>+ deductForPaidOrder(order: Order, performedBy: String)<BR ALIGN="LEFT"/>+ restockCanceledOrder(order: Order, performedBy: String)<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  "ProductLookup" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0"><TR><TD BGCOLOR="#FFFFFF" CELLPADDING="4"><FONT POINT-SIZE="9">«interface»</FONT><BR/><B>ProductLookup</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ getProductById(id: String): Product<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  "PurchaseHistory" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0"><TR><TD BGCOLOR="#FFFFFF" CELLPADDING="4"><FONT POINT-SIZE="9">«interface»</FONT><BR/><B>PurchaseHistory</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ hasUserPurchased(userId: String, productId: String): boolean<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  "OrderStockHandler" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0"><TR><TD BGCOLOR="#FFFFFF" CELLPADDING="4"><FONT POINT-SIZE="9">«interface»</FONT><BR/><B>OrderStockHandler</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ deductForPaidOrder(order: Order, performedBy: String)<BR ALIGN="LEFT"/>+ restockCanceledOrder(order: Order, performedBy: String)<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  "PaymentVerificationRule" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0"><TR><TD BGCOLOR="#FFFFFF" CELLPADDING="4"><FONT POINT-SIZE="9">«interface»</FONT><BR/><B>PaymentVerificationRule</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ check(order: Order, response: GatewayResponse): Optional&lt;String&gt;<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  "GatewayApprovalRule" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0"><TR><TD BGCOLOR="#FFFFFF" CELLPADDING="4"><B>GatewayApprovalRule</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ check(order: Order, response: GatewayResponse): Optional&lt;String&gt;<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  "PaidAmountRule" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0"><TR><TD BGCOLOR="#FFFFFF" CELLPADDING="4"><B>PaidAmountRule</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ check(order: Order, response: GatewayResponse): Optional&lt;String&gt;<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  "TransactionReferenceRule" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0"><TR><TD BGCOLOR="#FFFFFF" CELLPADDING="4"><B>TransactionReferenceRule</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ check(order: Order, response: GatewayResponse): Optional&lt;String&gt;<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  "StockAvailabilityRule" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0"><TR><TD BGCOLOR="#FFFFFF" CELLPADDING="4"><B>StockAvailabilityRule</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- productLookup: ProductLookup {readOnly}<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ check(order: Order, response: GatewayResponse): Optional&lt;String&gt;<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  "PaymentGateway" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0"><TR><TD BGCOLOR="#FFFFFF" CELLPADDING="4"><FONT POINT-SIZE="9">«interface»</FONT><BR/><B>PaymentGateway</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ charge(orderId: String, amount: BigDecimal, method: PaymentMethod): GatewayResponse<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  "SimulatedPaymentGateway" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0"><TR><TD BGCOLOR="#FFFFFF" CELLPADDING="4"><B>SimulatedPaymentGateway</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- approveNext: boolean<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ setApproveNext(approveNext: boolean)<BR ALIGN="LEFT"/>+ charge(orderId: String, amount: BigDecimal, method: PaymentMethod): GatewayResponse<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  "GatewaySimulationControl" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0"><TR><TD BGCOLOR="#FFFFFF" CELLPADDING="4"><FONT POINT-SIZE="9">«interface»</FONT><BR/><B>GatewaySimulationControl</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ setApproveNext(approveNext: boolean)<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  "GatewayResponse" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0"><TR><TD BGCOLOR="#FFFFFF" CELLPADDING="4"><B>GatewayResponse</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- approved: boolean {readOnly}<BR ALIGN="LEFT"/>- paidAmount: BigDecimal {readOnly}<BR ALIGN="LEFT"/>- transactionRef: String {readOnly}<BR ALIGN="LEFT"/>- message: String {readOnly}<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"> </TD></TR></TABLE>>];
  "OrderRepository" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0"><TR><TD BGCOLOR="#EEEEEE" CELLPADDING="4"><FONT POINT-SIZE="9">«interface»</FONT><BR/><B>OrderRepository</B></TD></TR></TABLE>>];
  "ProductRepository" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0"><TR><TD BGCOLOR="#EEEEEE" CELLPADDING="4"><FONT POINT-SIZE="9">«interface»</FONT><BR/><B>ProductRepository</B></TD></TR></TABLE>>];
  "ProductService" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0"><TR><TD BGCOLOR="#EEEEEE" CELLPADDING="4"><B>ProductService</B></TD></TR></TABLE>>];
  "CartService" -> "ProductLookup" [arrowhead=vee, style=solid, label=" productLookup ", headlabel="1"];
  "OrderService" -> "OrderRepository" [arrowhead=vee, style=solid, label=" orderRepository ", headlabel="1"];
  "OrderService" -> "CartService" [arrowhead=vee, style=solid, label=" cartService ", headlabel="1"];
  "OrderService" -> "OrderStockHandler" [arrowhead=vee, style=solid, label=" stockHandler ", headlabel="1"];
  "PurchaseHistory" -> "OrderService" [dir=back, arrowtail=onormal, style=dashed];
  "PaymentService" -> "OrderRepository" [arrowhead=vee, style=solid, label=" orderRepository ", headlabel="1"];
  "PaymentService" -> "PaymentGateway" [arrowhead=vee, style=solid, label=" gateway ", headlabel="1"];
  "PaymentService" -> "PaymentVerificationRule" [arrowhead=vee, style=solid, label=" verificationRules ", headlabel="0..*"];
  "PaymentService" -> "OrderStockHandler" [arrowhead=vee, style=solid, label=" stockHandler ", headlabel="1"];
  "ReviewService" -> "ProductLookup" [arrowhead=vee, style=solid, label=" productLookup ", headlabel="1"];
  "ReviewService" -> "PurchaseHistory" [arrowhead=vee, style=solid, label=" purchaseHistory ", headlabel="1"];
  "InventoryService" -> "ProductRepository" [arrowhead=vee, style=solid, label=" productRepository ", headlabel="1"];
  "OrderStockHandler" -> "InventoryService" [dir=back, arrowtail=onormal, style=dashed];
  "PaymentVerificationRule" -> "GatewayApprovalRule" [dir=back, arrowtail=onormal, style=dashed];
  "PaymentVerificationRule" -> "PaidAmountRule" [dir=back, arrowtail=onormal, style=dashed];
  "PaymentVerificationRule" -> "TransactionReferenceRule" [dir=back, arrowtail=onormal, style=dashed];
  "StockAvailabilityRule" -> "ProductLookup" [arrowhead=vee, style=solid, label=" productLookup ", headlabel="1"];
  "PaymentVerificationRule" -> "StockAvailabilityRule" [dir=back, arrowtail=onormal, style=dashed];
  "PaymentGateway" -> "SimulatedPaymentGateway" [dir=back, arrowtail=onormal, style=dashed];
  "GatewaySimulationControl" -> "SimulatedPaymentGateway" [dir=back, arrowtail=onormal, style=dashed];
  "ProductLookup" -> "ProductService" [dir=back, arrowtail=onormal, style=dashed];
  "PaymentService" -> "GatewayResponse" [arrowhead=vee, style=dashed, label=" «use» "];
  "PaymentGateway" -> "GatewayResponse" [arrowhead=vee, style=dashed, label=" «create» "];
  note [shape=note, fontsize=9, style=filled, fillcolor="#FFFDE7", label="Package shop.service (orders and payment)\lAll services also use Authorization for access checks (omitted).\lConstructors and simple getters are omitted.\l"];
}
