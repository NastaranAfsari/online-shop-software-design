digraph ObjectDiagram {
  graph [rankdir=TB, fontname="DejaVu Sans", nodesep=0.4, ranksep=0.6, pad=0.3];
  node [shape=plain, fontname="DejaVu Sans", fontsize=10];
  edge [fontname="DejaVu Sans", fontsize=9, color="#333333"];
    "session" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0"><TR><TD BGCOLOR="#FFFFFF" CELLPADDING="4"><U><B>session : UserSession</B></U></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">currentUser = ali<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  "ali" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0"><TR><TD BGCOLOR="#FFFFFF" CELLPADDING="4"><U><B>ali : User</B></U></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">id = &quot;u-ali&quot;<BR ALIGN="LEFT"/>fullName = &quot;Ali Rezaei&quot;<BR ALIGN="LEFT"/>email = &quot;ali@shop.com&quot;<BR ALIGN="LEFT"/>phone = &quot;09121111111&quot;<BR ALIGN="LEFT"/>role = CUSTOMER<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  "aliCart" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0"><TR><TD BGCOLOR="#FFFFFF" CELLPADDING="4"><U><B>aliCart : Cart</B></U></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">userId = &quot;u-ali&quot;<BR ALIGN="LEFT"/>items = [ ]  (cleared after checkout)<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  "home" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0"><TR><TD BGCOLOR="#FFFFFF" CELLPADDING="4"><U><B>home : Address</B></U></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">title = &quot;Home&quot;<BR ALIGN="LEFT"/>recipientName = &quot;Ali Rezaei&quot;<BR ALIGN="LEFT"/>phoneNumber = &quot;09121111111&quot;<BR ALIGN="LEFT"/>country = &quot;Iran&quot;<BR ALIGN="LEFT"/>city = &quot;Tehran&quot;<BR ALIGN="LEFT"/>street = &quot;Street 1&quot;<BR ALIGN="LEFT"/>postalCode = &quot;1234567890&quot;<BR ALIGN="LEFT"/>defaultAddress = true<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  "order1" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0"><TR><TD BGCOLOR="#FFFFFF" CELLPADDING="4"><U><B>order1 : Order</B></U></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">id = &quot;o-1&quot;<BR ALIGN="LEFT"/>userId = &quot;u-ali&quot;<BR ALIGN="LEFT"/>status = PAID<BR ALIGN="LEFT"/>/totalAmount = 1825.00 (derived)<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  "item1" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0"><TR><TD BGCOLOR="#FFFFFF" CELLPADDING="4"><U><B>item1 : OrderItem</B></U></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">productId = &quot;p-air&quot;<BR ALIGN="LEFT"/>productName = &quot;Laptop Air&quot;<BR ALIGN="LEFT"/>unitPrice = 900.00<BR ALIGN="LEFT"/>quantity = 2<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  "item2" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0"><TR><TD BGCOLOR="#FFFFFF" CELLPADDING="4"><U><B>item2 : OrderItem</B></U></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">productId = &quot;p-mouse&quot;<BR ALIGN="LEFT"/>productName = &quot;Wireless Mouse&quot;<BR ALIGN="LEFT"/>unitPrice = 25.00<BR ALIGN="LEFT"/>quantity = 1<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  "pay1" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0"><TR><TD BGCOLOR="#FFFFFF" CELLPADDING="4"><U><B>pay1 : Payment</B></U></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">orderId = &quot;o-1&quot;<BR ALIGN="LEFT"/>amount = 1825.00<BR ALIGN="LEFT"/>method = CREDIT_CARD<BR ALIGN="LEFT"/>status = FAILED<BR ALIGN="LEFT"/>failureReason = &quot;Declined by the gateway&quot;<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  "pay2" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0"><TR><TD BGCOLOR="#FFFFFF" CELLPADDING="4"><U><B>pay2 : Payment</B></U></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">orderId = &quot;o-1&quot;<BR ALIGN="LEFT"/>amount = 1825.00<BR ALIGN="LEFT"/>method = ONLINE_GATEWAY<BR ALIGN="LEFT"/>status = SUCCESS<BR ALIGN="LEFT"/>transactionRef = &quot;TXN-4F9A21C0&quot;<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  "laptopAir" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0"><TR><TD BGCOLOR="#FFFFFF" CELLPADDING="4"><U><B>laptopAir : Product</B></U></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">id = &quot;p-air&quot;<BR ALIGN="LEFT"/>title = &quot;Laptop Air&quot;<BR ALIGN="LEFT"/>brand = &quot;Apple&quot;<BR ALIGN="LEFT"/>price = 900.00<BR ALIGN="LEFT"/>stock = 6<BR ALIGN="LEFT"/>soldCount = 2<BR ALIGN="LEFT"/>active = true<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  "mouse" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0"><TR><TD BGCOLOR="#FFFFFF" CELLPADDING="4"><U><B>mouse : Product</B></U></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">id = &quot;p-mouse&quot;<BR ALIGN="LEFT"/>title = &quot;Wireless Mouse&quot;<BR ALIGN="LEFT"/>brand = &quot;Logitech&quot;<BR ALIGN="LEFT"/>price = 25.00<BR ALIGN="LEFT"/>stock = 49<BR ALIGN="LEFT"/>soldCount = 1<BR ALIGN="LEFT"/>active = true<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  "electronics" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0"><TR><TD BGCOLOR="#FFFFFF" CELLPADDING="4"><U><B>electronics : Category</B></U></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">name = &quot;Electronics&quot;<BR ALIGN="LEFT"/>description = &quot;Digital products&quot;<BR ALIGN="LEFT"/>active = true<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  "review1" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0"><TR><TD BGCOLOR="#FFFFFF" CELLPADDING="4"><U><B>review1 : Review</B></U></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">userId = &quot;u-ali&quot;<BR ALIGN="LEFT"/>reviewerName = &quot;Ali&quot;<BR ALIGN="LEFT"/>score = 5<BR ALIGN="LEFT"/>comment = &quot;Great laptop&quot;<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  "movement1" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0"><TR><TD BGCOLOR="#FFFFFF" CELLPADDING="4"><U><B>movement1 : StockMovement</B></U></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">productId = &quot;p-air&quot;<BR ALIGN="LEFT"/>delta = -2<BR ALIGN="LEFT"/>resultingStock = 6<BR ALIGN="LEFT"/>reason = &quot;Order o-1 paid&quot;<BR ALIGN="LEFT"/>performedBy = &quot;u-ali&quot;<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  "session" -> "ali" [label=" currentUser ", arrowhead=vee];
  "ali" -> "aliCart" [label=" cart ", arrowhead=vee];
  "ali" -> "home" [label=" addresses ", arrowhead=vee];
  "order1" -> "home" [label=" deliveryAddress ", arrowhead=vee];
  "order1" -> "item1" [label=" items ", arrowhead=vee];
  "order1" -> "item2" [label=" items ", arrowhead=vee];
  "order1" -> "pay1" [label=" payments ", arrowhead=vee];
  "order1" -> "pay2" [label=" payments ", arrowhead=vee];
  "laptopAir" -> "electronics" [label=" category ", arrowhead=vee];
  "mouse" -> "electronics" [label=" category ", arrowhead=vee];
  "laptopAir" -> "review1" [label=" reviews ", arrowhead=vee];
  "laptopAir" -> "movement1" [label=" stockHistory ", arrowhead=vee];
  note [shape=note, fontsize=9, style=filled, fillcolor="#FFFDE7", label="State right after Ali checked out\l2 x Laptop Air + 1 x Wireless Mouse: the first payment (credit card)\lwas declined, the second (online gateway) succeeded. Stock was\ldeducted only after the successful payment (8 to 6, 50 to 49),\land then Ali rated and reviewed the laptop.\lIds are shortened for readability (real ids are UUIDs).\l"];
}